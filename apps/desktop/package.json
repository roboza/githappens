{
  "name": "@githappens/desktop",
  "productName": "GitHappens",
  "version": "0.1.0",
  "private": true,
  "description": "GitHappens desktop Git client",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@parcel/watcher": "^2.6.0",
    "culori": "^4.0.2",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15",
    "@parcel/watcher-darwin-arm64": "2.6.0",
    "@parcel/watcher-darwin-x64": "2.6.0",
    "@parcel/watcher-linux-arm64-glibc": "2.6.0",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@parcel/watcher-win32-arm64": "2.6.0",
    "@parcel/watcher-win32-x64": "2.6.0"
  },
  "devDependencies": {
    "@githappens/cloud-api": "workspace:*",
    "@githappens/git": "workspace:*",
    "@githappens/graph": "workspace:*",
    "@githappens/launchpad": "workspace:*",
    "@githappens/providers": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.64.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dugite": "^3.2.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.53.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  }
}
