<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements (spec 15 §6.4). Used for the app and, via entitlementsInherit,
  for every helper / bundled binary (Electron helpers, node-pty, bundled git).
-->
<plist version="1.0">
  <dict>
    <!-- V8 JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native modules (node-pty, @parcel/watcher) are signed by us, not Apple/Electron. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Bundled git / user hooks may rely on DYLD_* (e.g. custom credential helpers). -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
  </dict>
</plist>
