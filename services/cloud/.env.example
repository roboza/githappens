# Copy to .env next to docker-compose.yml and edit. Never commit the real .env.
GH_DB_PASSWORD=change-me-to-a-long-random-string
GH_CLOUD_PUBLIC_URL=https://cloud.example.com
# Behind a reverse proxy: take the client IP from X-Forwarded-For (rate limiting).
GH_CLOUD_TRUST_PROXY=true
# Interface the container port binds to on the host (keep 127.0.0.1 behind a local proxy).
GH_CLOUD_BIND=127.0.0.1

# Identity providers (enable at least one). Callback URL to register with each provider:
#   <GH_CLOUD_PUBLIC_URL>/oauth/callback/github | gitlab | google
GH_CLOUD_GITHUB_CLIENT_ID=
GH_CLOUD_GITHUB_CLIENT_SECRET=
GH_CLOUD_GITLAB_CLIENT_ID=
GH_CLOUD_GITLAB_CLIENT_SECRET=
GH_CLOUD_GITLAB_URL=https://gitlab.com
GH_CLOUD_GOOGLE_CLIENT_ID=
GH_CLOUD_GOOGLE_CLIENT_SECRET=
# Email magic links: none | log (prints links to the container log; testing only) | webhook
GH_CLOUD_MAIL_TRANSPORT=none
GH_CLOUD_MAIL_WEBHOOK=
