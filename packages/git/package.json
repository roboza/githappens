{
  "name": "@githappens/git",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Git process runner, executable locator, progress & error parsing (spec 02).",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./ops": "./src/ops/types.ts",
    "./signature": "./src/service/signature.ts",
    "./gitflow": "./src/service/gitflow.ts",
    "./completions": "./src/completions.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "gen:completions": "tsx scripts/gen-completions.ts && prettier --write src/completions.json",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx bench/run.ts"
  },
  "devDependencies": {
    "@githappens/fixtures": "workspace:*",
    "@vitest/coverage-v8": "5.0.3"
  }
}
